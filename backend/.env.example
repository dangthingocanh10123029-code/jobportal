# Copy thành backend/.env (đã gitignore)
# Transaction pooler URL của Supabase (Dashboard → Connect → Transaction pooler, cổng 6543), user postgres.<project-ref>.
# Không dùng session pooler (5432): chỉ 15 client dùng chung, pool API chiếm hết → psql/seed/test lỗi EMAXCONNSESSION.
# Test tích hợp cũng chạy với URL này; cần session thật (psql dài, LISTEN, SET cấp phiên) thì dùng tay cổng 5432.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Số kết nối tối đa của pool API (mặc định 10)
# DB_POOL_MAX_SIZE=10
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Next.js dev server được phép gọi (CORS chỉ cần khi gọi từ trình duyệt; Server Actions gọi server→server)
ALLOWED_ORIGINS=http://localhost:3000
