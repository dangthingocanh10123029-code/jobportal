{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "API_URL" }]
    },
    "api": {
      "root": "backend",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
